{
  "purpose": "Physical model behind every recommended print parameter in Parts Bench / Filament Bench.",
  "constants": {
    "filamentRadiusMm": 0.875,
    "filamentAreaMm2": 2.405,
    "meltCoefficientAnchorPLA": 0.325,
    "nozzleLandLengthMm": 0.6,
    "ambientC": 25
  },
  "formulas": {
    "effectiveMeltVolume": "V_eff = V0 * (D/0.4)^e   where V0 is the hotend's vEffMm3At0p4 for the nozzle class and e is the material's expStandard or expHighFlow",
    "meltLimitedFlow": "Q_melt = meltCoefA * highFlowResponse(if high-flow nozzle) * V_eff * spoolFlowFactor",
    "flowCeiling": "Q_max = min(Q_melt, hotend ratingMm3s)",
    "extrusionCrossSection": "A = w*h - h^2*(1 - pi/4)",
    "maxSpeed": "v = Q_used / A     where Q_used = Q_max * goal.flowUseFraction",
    "heaterPower": "P = Q * density * (cp * (T - ambient) + latentHeat)   compare against heaterW * 0.8",
    "meltResidenceTime": "tau = V_eff / Q     flag below 2 s, critical below 1.2 s",
    "wallShearRate": "gammaDot = Q*(3n+1)/(pi*n*R^3)   R = nozzle radius in metres, Q in m3/s",
    "nozzlePressureDrop": "tau_w = K * gammaDot^n ;  dP = 2*tau_w*L/R ;  force = dP * filamentArea",
    "pressureAdvance": "k = PA_BASE[material] * (0.4/D) * hotend.paFactor * spoolPaFactor",
    "nozzleTemperature": "T = material.nozzleC + 12*log2(Q_used / (0.55*Q_max)) + goal.deltaNozzleC, clamped to the material range and the hotend/printer ceiling",
    "spoolFlowFactor": "measuredMaxFlow / (meltCoefA * highFlowResponse * V_eff)  - solved from ONE measurement, then applied to every other hotend and nozzle for that spool"
  },
